# Template only. scripts/mysql-local.sh prepare creates data/mysql.env with
# independent random passwords and mode 0600; old configurations gain only missing projection fields.
SLG_MYSQL_PORT=13306
# SLG_MYSQL_IMAGE=mysql:8.4
SLG_MYSQL_ROOT_PASSWORD=GENERATE_ROOT_PASSWORD
SLG_UC_DB_USER=slg_uc
SLG_UC_DB_PASSWORD=GENERATE_UC_PASSWORD
SLG_PROJECTION_DB_USER=slg_projection
SLG_PROJECTION_DB_PASSWORD=GENERATE_PROJECTION_PASSWORD

# Local Docker connection only. Production should use private networking and TLS.
SLG_UC_JDBC_URL='jdbc:mysql://127.0.0.1:13306/slg_uc?sslMode=DISABLED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&connectTimeout=5000&socketTimeout=15000'
SLG_PROJECTION_ENABLED=true
SLG_PROJECTION_JDBC_URL='jdbc:mysql://127.0.0.1:13306/slg_projection?sslMode=DISABLED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&connectTimeout=2000&socketTimeout=5000'
# 首次使用已运行过的 MySQL 数据卷时，运行 ./scripts/mysql-local.sh provision，再启动应用。
# SLG_PROJECTION_BATCH_SIZE=64
# SLG_PROJECTION_MAX_LAG=100000
SLG_DB_POOL_SIZE=8
SLG_DB_CONNECTION_TIMEOUT_MS=5000

SLG_BIND=127.0.0.1
SLG_GATE_PORT=8080
SLG_UC_PORT=8081
SLG_GAME_PORT=8082
SLG_UC_RPC_PORT=9081
SLG_GAME_RPC_PORT=9082
SLG_BATTLE_RPC_PORT=9083
# SLG_BATTLE_RPC_TARGET=127.0.0.1:9083
# SLG_BATTLE_WORKERS=4
# SLG_BATTLE_QUEUE_CAPACITY=128

# 启动 GAME 前绑定已初始化的原卷。这三项可写入环境或配置文件。
# 新区先创建空目录并显式执行一次 volume init；后续始终复用同一组值。
# SLG_REALM_DIR=/absolute/path/to/realm-1
# SLG_REALM_ID=1
# SLG_REALM_VOLUME_ID=<canonical-volume-uuid>

# 原卷文件系统的剩余可写字节；硬线及以下暂缓新客户端写入，恢复到告警线才重新放行。
# SLG_REALM_DISK_WARN_BYTES=2147483648
# SLG_REALM_DISK_HARD_BYTES=1073741824
# 清理预演至少留下最近这么多条业务日志，只计算候选范围。
# SLG_REALM_JOURNAL_KEEP_ENTRIES=10000
# SLG_TOKEN_SECRET is generated/reused by the application launcher in data/local.env.

# HikariCP 生命周期参数（毫秒），keepalive 必须小于 maxLifetime。
# SLG_DB_MINIMUM_IDLE=8
# SLG_DB_VALIDATION_TIMEOUT_MS=1000
# SLG_DB_MAX_LIFETIME_MS=1800000
# SLG_DB_KEEPALIVE_MS=120000

# 生产内部 RPC 配置 TLS；提供 CA 时服务端要求客户端证书（mTLS）。
# SLG_RPC_TLS_ENABLED=true
# SLG_RPC_TLS_CA=/run/secrets/rpc-ca.pem
# SLG_RPC_TLS_CERT=/run/secrets/server.pem
# SLG_RPC_TLS_KEY=/run/secrets/server-key.pem
# Gateway 调用 UC / GAME 使用的客户端证书和私钥，仅交给 Gateway。
# SLG_RPC_CLIENT_TLS_CERT=/run/secrets/gateway.pem
# SLG_RPC_CLIENT_TLS_KEY=/run/secrets/gateway-key.pem
# GAME 调用 Worker 使用的独立客户端证书/私钥，启动器仅映射到 GAME 进程。
# SLG_BATTLE_CLIENT_TLS_CERT=/run/secrets/game-to-battle.pem
# SLG_BATTLE_CLIENT_TLS_KEY=/run/secrets/game-to-battle-key.pem
# 仅 Worker 使用，信任专门为 GAME 客户端签发证书的 CA。
# SLG_BATTLE_GAME_CLIENT_CA=/run/secrets/game-client-ca.pem
